# Copy to .env only if you want to override the docker-compose defaults.
# docker compose already runs with sane defaults without this file.

# --- Ports on the host ---
API_PORT=8080
DB_PORT=5433          # host port -> container's 5432 (5433 dodges a local Postgres)
REDIS_PORT=6379

# --- Credentials ---
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace_pass
POSTGRES_DB=marketplace_db

# --- App (used when running outside docker: pytest, alembic, uvicorn) ---
DATABASE_URL=postgresql://marketplace:marketplace_pass@localhost:5433/marketplace_db
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

ORDER_RESERVATION_MINUTES=15
PRODUCT_CACHE_TTL_SECONDS=60

APP_ENV=development
